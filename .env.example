# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Closed API models (set whichever you use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Local model servers
VLLM_BASE_URL=http://localhost:8000/v1
OLLAMA_BASE_URL=http://localhost:11434

# Hugging Face (only needed for gated models such as Llama)
HF_TOKEN=
